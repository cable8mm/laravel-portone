{
	"name": "cable8mm/laravel-portone",
	"description": "Laravel package for PortOne payments.",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": "^8.2",
		"illuminate/database": "^12.0 || ^13.0",
		"illuminate/support": "^12.0 || ^13.0",
		"cable8mm/portone-php": "^0.4"
	},
	"require-dev": {
		"orchestra/testbench": "^10.0 || ^11.0",
		"phpunit/phpunit": "^11.5 || ^12",
		"laravel/pint": "^1.0",
		"phpstan/phpstan": "^2.0",
		"larastan/larastan": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"Cable8mm\\LaravelPortone\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/",
			"Workbench\\App\\": "workbench/app/",
			"Workbench\\Database\\Factories\\": "workbench/database/factories/",
			"Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
		}
	},
	"scripts": {
		"format:check": "pint --test",
		"analyse": "phpstan analyse --no-progress",
		"test": "phpunit",
		"post-autoload-dump": ["@clear", "@prepare"],
		"clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
		"prepare": "@php vendor/bin/testbench package:discover --ansi",
		"build": "@php vendor/bin/testbench workbench:build --ansi",
		"serve": [
			"Composer\\Config::disableProcessTimeout",
			"@build",
			"@php vendor/bin/testbench serve --ansi"
		],
		"lint": [
			"@php vendor/bin/pint --ansi",
			"@php vendor/bin/phpstan analyse --verbose --ansi"
		]
	},
	"extra": {
		"laravel": {
			"providers": ["Cable8mm\\LaravelPortone\\PortOneServiceProvider"]
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
