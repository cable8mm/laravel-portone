{
  "name": "cable8mm/laravel-portone",
  "description": "Laravel package for PortOne payments.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "cable8mm/portone-php": "^0.4.1",
    "illuminate/console": "^12.0 || ^13.0",
    "illuminate/queue": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12",
    "laravel/pint": "^1.0",
    "phpstan/phpstan": "^2.0",
    "larastan/larastan": "^3.0",
    "orchestra/testbench-dusk": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Cable8mm\\LaravelPortone\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Factories\\": "workbench/database/factories/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "scripts": {
    "format:check": "pint --test",
    "analyse": "phpstan analyse --no-progress",
    "test": "phpunit",
    "live": [
      "Composer\\Config::disableProcessTimeout",
      "@putenv DUSK_HEADLESS_DISABLED=1",
      "phpunit --configuration phpunit.dusk.xml"
    ],
    "dusk:chrome-driver": "@php vendor/bin/testbench-dusk dusk:chrome-driver --detect",
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "build": [
      "npm run workbench:build",
      "@php vendor/bin/testbench workbench:build --ansi"
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ],
    "apidoc": "rm -rf build; rm -rf cache; doctum.phar update doctum.php --output-format=github --no-ansi --no-progress -v;",
    "opendoc": "open build/index.html",
    "lint": [
      "@php vendor/bin/pint --ansi",
      "@php vendor/bin/phpstan analyse --verbose --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cable8mm\\LaravelPortone\\PortOneServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
