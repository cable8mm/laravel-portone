{
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12 || >=24"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint",
    "format:check": "prettier --check stubs tests/js vitest.config.js eslint.config.js",
    "format": "prettier --write stubs tests/js vitest.config.js eslint.config.js",
    "lint": "eslint stubs tests/js vitest.config.js eslint.config.js",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@portone/browser-sdk": "^0.1.13",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0",
    "prettier": "^3.9.10",
    "vitest": "^4.0"
  },
  "allowScripts": {
    "fsevents": true
  }
}
